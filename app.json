{
  "expo": {
    "name": "BFFL AI",
    "slug": "bfflai_native",
    "version": "1.0.0",
    "owner": "bfflai",
    "orientation": "portrait",
    "icon": "app/_assets/project/icon.png",
    "scheme": "bfflai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.bfflai-native",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow BFFL AI to access your microphone for voice messages.",
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition."
      }
    },
    "android": {
      "icon": "app/_assets/project/icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "app/_assets/project/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.bfflai_native",
      "usesCleartextTraffic": true,
      "permissions": ["android.permission.RECORD_AUDIO", "android.permission.MODIFY_AUDIO_SETTINGS"]
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "app/_assets/project/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow BFFL AI to access your microphone for voice messages."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "app/_assets/project/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-speech-recognition"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "77dd23e5-0332-4166-b9f6-dda6e0ac204f"
      }
    }
  }
}
