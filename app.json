{
  "expo": {
    "name": "bfflai_native",
    "slug": "bfflai_native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "app/assets/images/icon.png",
    "scheme": "bfflai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "app/assets/images/android-icon-foreground.png",
        "backgroundImage": "app/assets/images/android-icon-background.png",
        "monochromeImage": "app/assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.bfflai_native"
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "app/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "app/assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6738df97-f5ac-4675-8148-29371f277bbb"
      }
    }
  }
}
