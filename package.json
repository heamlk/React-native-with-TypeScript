  "scripts": {
    "start": "npx expo start",
    "web": "npx expo start --web",
    "web:build": "npx expo export -p web",
    "android": "npx expo run:android",
    "android:build": "npx expo prebuild --platform android",
    "android:build:apk": "cd android && gradlew assembleRelease",
    "android:build:aab": "cd android && gradlew bundleRelease",
    "ios": "npx expo run:ios",
    "ios:build": "npx expo prebuild --platform ios",
    "eas:build": "eas build",
    "eas:build:apk": "eas build -p android --profile preview",
    "eas:build:aab": "eas build -p android",
    "eas:build:ios": "eas build -p ios"
  },
